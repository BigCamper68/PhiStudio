<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">#80CBC4</item>
        <item name="android:navigationBarColor">#11151A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:buttonStyle">@style/PhiStudioButton</item>
    </style>

    <style name="PhiStudioButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/phistudio_button</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
